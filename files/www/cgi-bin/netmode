#!/bin/sh
# NetPilot HTTP API. uhttpd authenticates access with the router account.
# GET mode=status reads state. All changes require same-origin POST.
# select_node accepts a Base64-encoded UTF-8 name and changes the shared selector.
# Device modes and rule/global routing remain keyed by client MAC/IP.

echo "Content-Type: application/json; charset=utf-8"
echo "Cache-Control: no-store, no-cache, must-revalidate, max-age=0"
echo ""

NFT_TABLE="netmode"
CONF_DIR="${NETMODE_CONF_DIR:-/etc/allinone}"
CONF_FILE="${CONF_DIR}/config.yaml"
PEERS_FILE="${CONF_DIR}/peers.conf"
CLASH_LIST_FILE="${CONF_DIR}/clash_profiles.conf"
ADG_LIST_FILE="${CONF_DIR}/adg_sources.conf"
MIHOMO_API="http://127.0.0.1:9090"

mkdir -p "$CONF_DIR/proxy_providers" "$CONF_DIR/rule_providers" 2>/dev/null || true
if [ -w "$CONF_DIR" ] || [ ! -e "$CONF_DIR" ]; then
    [ -f "$PEERS_FILE" ] || touch "$PEERS_FILE" 2>/dev/null || true
    if [ ! -f "$CLASH_LIST_FILE" ]; then
        cat > "$CLASH_LIST_FILE" 2>/dev/null <<'EOF' || true

EOF
    fi
    if [ ! -f "$ADG_LIST_FILE" ]; then
        cat > "$ADG_LIST_FILE" 2>/dev/null <<'EOF' || true
adg_awavenue|秋风广告规则 AWAvenue|http|yaml|https://gcore.jsdelivr.net/gh/TG-Twilight/AWAvenue-Ads-Rule@main/Filters/AWAvenue-Ads-Rule-Clash.yaml|1
adg_hagezi_light|HaGeZi Light|http|text|https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/light-onlydomains.txt|1
EOF
    fi
fi

parse_query() {
    local key="$1"
    echo "$QUERY_STRING" | tr '&' '\n' | awk -F'=' -v k="$key" '$1 == k {print $2; exit}' | sed 's/[^a-zA-Z0-9_.-]//g'
}

REQ_MODE=$(parse_query "mode")
REQ_ROUTING=$(parse_query "routing")
REQ_ACTION=$(parse_query "action")
REQ_ID=$(parse_query "id")
REQ_NAME_B64=$(parse_query "name_b64")
REQ_FILENAME=$(parse_query "filename")
OVERRIDE_IP=$(parse_query "ip")

CLIENT_IP="${REMOTE_ADDR:-}"
CLIENT_IP="${CLIENT_IP#::ffff:}"
if [ -z "$CLIENT_IP" ] && [ -n "$OVERRIDE_IP" ]; then
    CLIENT_IP="$OVERRIDE_IP"
fi
[ -z "$CLIENT_IP" ] && CLIENT_IP="192.168.1.100"

b64_decode() {
    if command -v base64 >/dev/null 2>&1; then
        base64 -d 2>/dev/null || base64 -d -i 2>/dev/null
    elif command -v openssl >/dev/null 2>&1; then
        openssl base64 -d -A 2>/dev/null
    fi
}

decode_name() {
    local fallback="$1"
    if [ -n "$REQ_NAME_B64" ]; then
        local n
        n=$(echo "$REQ_NAME_B64" | tr '_-' '/+' | b64_decode | tr -d '|\r\n')
        [ -n "$n" ] && { echo "$n"; return; }
    fi
    echo "$fallback"
}

json_escape() {
    echo "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\r\n'
}

# Compile subscriptions and filters, validate, then restart the service.
rebuild_config_yaml() {
    local log="/tmp/netpilot-apply.$$"
    if ! /usr/sbin/netpilot-rebuild --apply > "$log" 2>&1; then
        SOURCE_FAILED=1
        SOURCE_ERROR=$(head -1 "$log")
    fi
    rm -f "$log"
}

normalize_adg_text_file() {
    ( . /usr/lib/netpilot/config.sh; netpilot_domains "$1" > "$2" )
}

normalize_clash_yaml_file() {
    local src="$1"
    local dst="$2"
    if grep -q "^proxies:" "$src" 2>/dev/null && grep -Eq "^(rules|proxy-groups|dns|mixed-port|port):" "$src" 2>/dev/null; then
        awk '
            /^proxies:[ \t]*$/ { in_proxies=1; print "proxies:"; next }
            in_proxies && /^[a-zA-Z0-9_-]+:/ { in_proxies=0 }
            in_proxies { print $0 }
        ' "$src" > "$dst"
    else
        cp "$src" "$dst"
    fi
}

handle_source_actions() {
    local action="$1"
    local now_id
    now_id=$(date +%s 2>/dev/null || echo "$$")

    case "$action" in
        add_clash_url)
            local raw_body="/tmp/cgi_post.$$"
            cat > "$raw_body"
            local url
            url=$(cat "$raw_body" | b64_decode | tr -d '\r\n ')
            rm -f "$raw_body"
            if [ -n "$url" ]; then
                local cid="clash_${now_id}_$$"
                local cname
                cname=$(decode_name "订阅")
                local tmp="/tmp/clash_list.$$"
                # 将此前所有规则设为非激活 (0)，新添加的规则直接设为当前激活 (1)
                if [ -f "$CLASH_LIST_FILE" ]; then
                    awk -F'|' 'NF>=5 {print $1 "|" $2 "|" $3 "|" $4 "|0"}' "$CLASH_LIST_FILE" > "$tmp"
                else
                    : > "$tmp"
                fi
                echo "${cid}|${cname}|http|${url}|1" >> "$tmp"
                mv "$tmp" "$CLASH_LIST_FILE"
                rebuild_config_yaml
                ACTION_MSG="订阅已添加"
            fi
            ;;

        upload_clash)
            local raw_body="/tmp/cgi_post.$$"
            local tmp_up="/tmp/clash_up.$$"
            cat > "$raw_body"
            cat "$raw_body" | b64_decode > "$tmp_up"
            rm -f "$raw_body"
            if [ -s "$tmp_up" ]; then
                local cid="clash_${now_id}_$$"
                local fname="${REQ_FILENAME:-config.yaml}"
                local cname
                cname=$(decode_name "$fname")
                local rel_path="./proxy_providers/${cid}.yaml"
                normalize_clash_yaml_file "$tmp_up" "$CONF_DIR/proxy_providers/${cid}.yaml"
                local tmp="/tmp/clash_list.$$"
                if [ -f "$CLASH_LIST_FILE" ]; then
                    awk -F'|' 'NF>=5 {print $1 "|" $2 "|" $3 "|" $4 "|0"}' "$CLASH_LIST_FILE" > "$tmp"
                else
                    : > "$tmp"
                fi
                echo "${cid}|${cname}|file|${rel_path}|1" >> "$tmp"
                mv "$tmp" "$CLASH_LIST_FILE"
                rebuild_config_yaml
                ACTION_MSG="配置已导入"
            fi
            rm -f "$tmp_up"
            ;;

        select_clash)
            if [ -n "$REQ_ID" ] && [ -f "$CLASH_LIST_FILE" ]; then
                local tmp="/tmp/clash_list.$$"
                awk -F'|' -v target="$REQ_ID" '
                    NF>=5 {
                        act = ($1 == target) ? "1" : "0"
                        print $1 "|" $2 "|" $3 "|" $4 "|" act
                    }
                ' "$CLASH_LIST_FILE" > "$tmp" && mv "$tmp" "$CLASH_LIST_FILE"
                rebuild_config_yaml
                ACTION_MSG="已切换订阅"
            fi
            ;;

        del_clash)
            if [ -n "$REQ_ID" ] && [ -f "$CLASH_LIST_FILE" ]; then
                local total
                total=$(grep -c "|" "$CLASH_LIST_FILE" 2>/dev/null || echo 0)
                if [ "$total" -le 1 ]; then
                    ACTION_MSG="至少保留一个订阅"
                else
                    local tmp="/tmp/clash_list.$$"
                    awk -F'|' -v target="$REQ_ID" 'NF>=5 && $1 != target {print $0}' "$CLASH_LIST_FILE" > "$tmp"
                    # 若删除了原本激活的项，自动将第一项设为激活 (1)
                    if ! awk -F'|' '$5 == "1" {found=1} END {exit !found}' "$tmp"; then
                        awk -F'|' 'NR==1 {$5="1"} {print $1 "|" $2 "|" $3 "|" $4 "|" $5}' "$tmp" > "${tmp}.2" && mv "${tmp}.2" "$tmp"
                    fi
                    mv "$tmp" "$CLASH_LIST_FILE"
                    rm -f "$CONF_DIR/proxy_providers/${REQ_ID}.yaml" 2>/dev/null
                    rebuild_config_yaml
                    ACTION_MSG="订阅已删除"
                fi
            fi
            ;;

        add_adg_url)
            local raw_body="/tmp/cgi_post.$$"
            cat > "$raw_body"
            local url
            url=$(cat "$raw_body" | b64_decode | tr -d '\r\n ')
            rm -f "$raw_body"
            if [ -n "$url" ]; then
                local aid="adg_${now_id}_$$"
                local aname
                aname=$(decode_name "去广告规则")
                local fmt="text"
                case "$url" in
                    *.yaml|*.yml) fmt="yaml" ;;
                    *.txt|*.conf|*.list) fmt="text" ;;
                    *.mrs) fmt="mrs" ;;
                    *) fmt="text" ;;
                esac
                echo "${aid}|${aname}|http|${fmt}|${url}|1" >> "$ADG_LIST_FILE"
                rebuild_config_yaml
                ACTION_MSG="规则已添加"
            fi
            ;;

        upload_adg)
            local raw_body="/tmp/cgi_post.$$"
            local tmp_up="/tmp/adg_up.$$"
            cat > "$raw_body"
            cat "$raw_body" | b64_decode > "$tmp_up"
            rm -f "$raw_body"
            if [ -s "$tmp_up" ]; then
                local aid="adg_${now_id}_$$"
                local fname="${REQ_FILENAME:-adrules.txt}"
                local aname
                aname=$(decode_name "$fname")
                local fmt="text"
                local rel_path=""
                case "$fname" in
                    *.mrs)
                        fmt="mrs"
                        rel_path="./rule_providers/${aid}.mrs"
                        cp "$tmp_up" "$CONF_DIR/rule_providers/${aid}.mrs"
                        ;;
                    *.yaml|*.yml)
                        fmt="yaml"
                        rel_path="./rule_providers/${aid}.yaml"
                        cp "$tmp_up" "$CONF_DIR/rule_providers/${aid}.yaml"
                        ;;
                    *)
                        fmt="text"
                        rel_path="./rule_providers/${aid}.txt"
                        normalize_adg_text_file "$tmp_up" "$CONF_DIR/rule_providers/${aid}.txt"
                        ;;
                esac
                echo "${aid}|${aname}|file|${fmt}|${rel_path}|1" >> "$ADG_LIST_FILE"
                rebuild_config_yaml
                ACTION_MSG="规则已导入"
            fi
            rm -f "$tmp_up"
            ;;

        toggle_adg)
            if [ -n "$REQ_ID" ] && [ -f "$ADG_LIST_FILE" ]; then
                local tmp="/tmp/adg_list.$$"
                awk -F'|' -v target="$REQ_ID" '
                    NF>=6 {
                        en = $6
                        if ($1 == target) en = ($6 == "1" ? "0" : "1")
                        print $1 "|" $2 "|" $3 "|" $4 "|" $5 "|" en
                    }
                ' "$ADG_LIST_FILE" > "$tmp" && mv "$tmp" "$ADG_LIST_FILE"
                rebuild_config_yaml
                ACTION_MSG="规则已更新"
            fi
            ;;

        del_adg)
            if [ -n "$REQ_ID" ] && [ -f "$ADG_LIST_FILE" ]; then
                local tmp="/tmp/adg_list.$$"
                awk -F'|' -v target="$REQ_ID" 'NF>=6 && $1 != target {print $0}' "$ADG_LIST_FILE" > "$tmp" && mv "$tmp" "$ADG_LIST_FILE"
                rm -f "$CONF_DIR/rule_providers/${REQ_ID}".* 2>/dev/null
                rebuild_config_yaml
                ACTION_MSG="规则已删除"
            fi
            ;;
    esac
}

get_client_info() {
    local ip="$1"
    CLIENT_MAC=""
    CLIENT_HOST=""

    if [ -f /tmp/dhcp.leases ]; then
        local lease_line
        lease_line=$(awk -v target="$ip" '$3 == target {print tolower($2), $4; exit}' /tmp/dhcp.leases)
        if [ -n "$lease_line" ]; then
            CLIENT_MAC=$(echo "$lease_line" | awk '{print $1}')
            CLIENT_HOST=$(echo "$lease_line" | awk '{print $2}')
        fi
    fi

    if [ -z "$CLIENT_MAC" ] && [ -f /proc/net/arp ]; then
        CLIENT_MAC=$(awk -v target="$ip" '$1 == target && $3 != "0x0" {print tolower($4); exit}' /proc/net/arp)
    fi

    if [ -z "$CLIENT_MAC" ]; then
        CLIENT_MAC=$(ip -4 neigh show "$ip" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="lladdr") print tolower($(i+1)); exit}')
    fi

    if [ -z "$CLIENT_HOST" ] || [ "$CLIENT_HOST" = "*" ]; then
        if [ -n "$CLIENT_MAC" ] && [ -f "$PEERS_FILE" ]; then
            CLIENT_HOST=$(awk -F'|' -v m="$CLIENT_MAC" 'tolower($1) == m {print (NF>=5 ? $5 : $4); exit}' "$PEERS_FILE")
        fi
    fi

    [ -z "$CLIENT_MAC" ] && CLIENT_MAC="00:00:00:00:00:00"
    if [ -z "$CLIENT_HOST" ] || [ "$CLIENT_HOST" = "*" ]; then
        CLIENT_HOST="LAN-Device-${ip##*.}"
    fi
}

ensure_nft_table() {
    if ! nft list table inet "$NFT_TABLE" >/dev/null 2>&1; then
        /etc/init.d/allinone reload >/dev/null 2>&1
    fi
}

get_device_state() {
    local ip="$1"
    local mac="$2"
    DEV_MODE="direct"
    DEV_ROUTING="rule"

    if [ -f "$PEERS_FILE" ]; then
        local line=""
        if [ "$mac" != "00:00:00:00:00:00" ]; then
            line=$(awk -F'|' -v m="$mac" 'tolower($1) == m {print $3 "|" $4; exit}' "$PEERS_FILE")
        fi
        if [ -z "$line" ]; then
            line=$(awk -F'|' -v target="$ip" '$2 == target {print $3 "|" $4; exit}' "$PEERS_FILE")
        fi
        if [ -n "$line" ]; then
            local m="${line%%|*}"
            local r="${line#*|}"
            case "$m" in direct|adg|clash|both) DEV_MODE="$m" ;; esac
            case "$r" in rule|global) DEV_ROUTING="$r" ;; esac
        fi
    fi

    if nft list set inet "$NFT_TABLE" mode_both_global 2>/dev/null | grep -qw "$ip"; then
        DEV_MODE="both"
        DEV_ROUTING="global"
    elif nft list set inet "$NFT_TABLE" mode_both 2>/dev/null | grep -qw "$ip"; then
        DEV_MODE="both"
        DEV_ROUTING="rule"
    elif nft list set inet "$NFT_TABLE" mode_clash_global 2>/dev/null | grep -qw "$ip"; then
        DEV_MODE="clash"
        DEV_ROUTING="global"
    elif nft list set inet "$NFT_TABLE" mode_clash 2>/dev/null | grep -qw "$ip"; then
        DEV_MODE="clash"
        DEV_ROUTING="rule"
    elif nft list set inet "$NFT_TABLE" mode_adg 2>/dev/null | grep -qw "$ip"; then
        DEV_MODE="adg"
    fi
}

apply_device_state() {
    local ip="$1"
    local mac="$2"
    local new_mode="$3"
    local new_routing="$4"
    local host="$5"

    local lock=/var/lock/netpilot-state.lock tries=0 tmp_file old_file
    until mkdir "$lock" 2>/dev/null; do
        tries=$((tries + 1)); [ "$tries" -lt 10 ] || return 1; sleep 1
    done
    tmp_file=$(mktemp "$CONF_DIR/.state.XXXXXX") || { rmdir "$lock"; return 1; }
    old_file=$(mktemp "$CONF_DIR/.previous.XXXXXX") || { rm -f "$tmp_file"; rmdir "$lock"; return 1; }
    cp "$PEERS_FILE" "$old_file" || { rm -f "$tmp_file" "$old_file"; rmdir "$lock"; return 1; }
    awk -F'|' -v m="$mac" -v target="$ip" '
        !( (m != "00:00:00:00:00:00" && tolower($1) == m) || $2 == target ) { print $0 }
    ' "$PEERS_FILE" > "$tmp_file"
    printf '%s|%s|%s|%s|%s\n' "$mac" "$ip" "$new_mode" "$new_routing" "$host" >> "$tmp_file"
    chmod 600 "$tmp_file"
    mv "$tmp_file" "$PEERS_FILE"
    if ! NETPILOT_STATE_LOCKED=1 /etc/init.d/allinone reload >/dev/null 2>&1; then
        mv "$old_file" "$PEERS_FILE"
        NETPILOT_STATE_LOCKED=1 /etc/init.d/allinone reload >/dev/null 2>&1 || true
        rmdir "$lock"
        return 1
    fi
    rm -f "$old_file"
    rmdir "$lock"
}

get_core_metrics() {
    CORE_RUNNING="false"
    CORE_MEM_MB="0.0"

    local pid
    pid=$(pidof mihomo 2>/dev/null | awk '{print $1}')
    if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
        CORE_RUNNING="true"
        local rss_kb
        rss_kb=$(awk '/VmRSS:/ {print $2}' "/proc/$pid/status" 2>/dev/null)
        if [ -n "$rss_kb" ] && [ "$rss_kb" -gt 0 ] 2>/dev/null; then
            CORE_MEM_MB=$(awk -v kb="$rss_kb" 'BEGIN {printf "%.1f", kb / 1024.0}')
        fi
    fi
}

# 生成 Clash 规则列表 JSON 数组
build_clash_list_json() {
    if [ ! -f "$CLASH_LIST_FILE" ]; then
        echo "[]"
        return
    fi
    awk -F'|' '
        BEGIN { printf "["; first=1 }
        NF>=5 {
            gsub(/\\/, "\\\\", $2); gsub(/"/, "\\\"", $2)
            gsub(/\\/, "\\\\", $4); gsub(/"/, "\\\"", $4)
            if (!first) printf ","
            first=0
            act = ($5 == "1") ? "true" : "false"
            printf "{\"id\":\"%s\",\"name\":\"%s\",\"type\":\"%s\",\"value\":\"%s\",\"active\":%s}", $1, $2, $3, $4, act
        }
        END { printf "]" }
    ' "$CLASH_LIST_FILE"
}

# 生成 AdGuard 规则订阅列表 JSON 数组
build_adg_list_json() {
    if [ ! -f "$ADG_LIST_FILE" ]; then
        echo "[]"
        return
    fi
    awk -F'|' '
        BEGIN { printf "["; first=1 }
        NF>=6 {
            gsub(/\\/, "\\\\", $2); gsub(/"/, "\\\"", $2)
            gsub(/\\/, "\\\\", $5); gsub(/"/, "\\\"", $5)
            if (!first) printf ","
            first=0
            en = ($6 == "1") ? "true" : "false"
            printf "{\"id\":\"%s\",\"name\":\"%s\",\"type\":\"%s\",\"format\":\"%s\",\"value\":\"%s\",\"enabled\":%s}", $1, $2, $3, $4, $5, en
        }
        END { printf "]" }
    ' "$ADG_LIST_FILE"
}

api_error() {
    printf '{"ok":false,"message":"%s","code":"%s"}\n' "$(json_escape "$1")" "${2:-operation_failed}"
    exit 0
}
case "${REQUEST_METHOD:-GET}" in GET|POST) ;; *) api_error '请求方法不受支持' ;; esac
if [ -n "${HTTP_ORIGIN:-}" ]; then
    case "$HTTP_ORIGIN" in "http://${HTTP_HOST:-}"|"https://${HTTP_HOST:-}") ;; *) api_error '拒绝跨站修改请求' ;; esac
fi
if [ -n "$REQ_ACTION$REQ_ROUTING" ] || { [ -n "$REQ_MODE" ] && [ "$REQ_MODE" != status ]; }; then
    [ "${REQUEST_METHOD:-GET}" = POST ] || api_error '修改操作需要 POST'
fi
if [ "${CONTENT_LENGTH:-0}" -gt 4194304 ]; then api_error '上传文件不能超过 3 MB'; fi
if ! echo "$CLIENT_IP" | awk -F. 'NF!=4 {exit 1} {for(i=1;i<=4;i++) if($i !~ /^[0-9]+$/ || $i>255) exit 1}'; then
    api_error '请使用路由器的 IPv4 地址访问控制台'
fi
API_LOCK=/var/lock/netpilot-api.lock
mkdir "$API_LOCK" 2>/dev/null || api_error '正在应用其他修改，请稍后重试' busy
trap 'rmdir "$API_LOCK" 2>/dev/null || true' EXIT INT TERM

get_client_info "$CLIENT_IP"
get_device_state "$CLIENT_IP" "$CLIENT_MAC"
PREVIOUS_MODE="$DEV_MODE"
PREVIOUS_ROUTING="$DEV_ROUTING"
ACTION_MSG="已刷新"
NODES_JSON=""
CONNECTIONS_RESET=0
CONNECTION_RESET_OK=null

if [ "$REQ_ACTION" = record_diagnostic ]; then
    [ "${CONTENT_LENGTH:-0}" -le 32768 ] || api_error '检查结果过大'
    umask 077
    diagnostic_input=$(mktemp /tmp/netpilot-diagnostic-input.XXXXXX) || api_error '无法保存检查结果'
    diagnostic_output=$(mktemp /tmp/netpilot-diagnostic-output.XXXXXX) || { rm -f "$diagnostic_input"; api_error '无法保存检查结果'; }
    b64_decode > "$diagnostic_input"
    if ! ucode /usr/lib/netpilot/diagnostic.uc "$diagnostic_input" "$CLIENT_IP" "$DEV_MODE" "$DEV_ROUTING" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$diagnostic_output"; then
        rm -f "$diagnostic_input" "$diagnostic_output"; api_error '检查结果格式不正确'
    fi
    if ! mv "$diagnostic_output" "/tmp/netpilot-diagnostic-$CLIENT_IP.json"; then
        rm -f "$diagnostic_input" "$diagnostic_output"; api_error '无法保存检查结果'
    fi
    rm -f "$diagnostic_input"
    ACTION_MSG="检查结果已保存"
elif [ "$REQ_ACTION" = select_node ] || [ "$REQ_ACTION" = check_nodes ]; then
    node_result="/tmp/netpilot-node-result.$$"
    if [ "$REQ_ACTION" = select_node ]; then
        [ "${CONTENT_LENGTH:-0}" -le 4096 ] || api_error '节点名称过长'
        b64_decode | /usr/sbin/netpilot-nodes select > "$node_result" 2>/dev/null || {
            rm -f "$node_result"; api_error '节点切换失败，请刷新后重试';
        }
        ACTION_MSG="节点已切换"
    else
        /usr/sbin/netpilot-nodes check > "$node_result" 2>/dev/null || {
            rm -f "$node_result"; api_error '延迟测试失败，请稍后重试';
        }
        ACTION_MSG="延迟已更新"
    fi
    NODES_JSON=$(cat "$node_result")
    rm -f "$node_result"
elif [ -n "$REQ_ACTION" ]; then
    case "$REQ_ACTION" in add_clash_url|upload_clash|select_clash|del_clash|add_adg_url|upload_adg|toggle_adg|del_adg) ;; *) api_error '未知操作' ;; esac
    SOURCE_FAILED=0
    cp "$CLASH_LIST_FILE" "$CLASH_LIST_FILE.bak"
    cp "$ADG_LIST_FILE" "$ADG_LIST_FILE.bak"
    handle_source_actions "$REQ_ACTION"
    if [ "$SOURCE_FAILED" = 1 ]; then
        mv "$CLASH_LIST_FILE.bak" "$CLASH_LIST_FILE"
        mv "$ADG_LIST_FILE.bak" "$ADG_LIST_FILE"
        api_error "$SOURCE_ERROR"
    fi
    rm -f "$CLASH_LIST_FILE.bak" "$ADG_LIST_FILE.bak"
fi

CHANGED=0
if [ -n "$REQ_MODE" ] && [ "$REQ_MODE" != "status" ]; then
    case "$REQ_MODE" in
        direct|adg|clash|both)
            DEV_MODE="$REQ_MODE"
            CHANGED=1
            case "$DEV_MODE" in
                direct) ACTION_MSG="已切换为直连" ;;
                adg)    ACTION_MSG="已开启去广告" ;;
                clash)  ACTION_MSG="已开启代理" ;;
                both)   ACTION_MSG="已开启去广告与代理" ;;
            esac
            ;;
    esac
fi

if [ -n "$REQ_ROUTING" ]; then
    case "$REQ_ROUTING" in
        rule|global)
            DEV_ROUTING="$REQ_ROUTING"
            CHANGED=1
            if [ "$DEV_ROUTING" = "global" ]; then
                ACTION_MSG="已设为全局代理"
            else
                ACTION_MSG="已设为规则分流"
            fi
            ;;
    esac
fi

if [ "$CHANGED" -eq 1 ]; then
    apply_device_state "$CLIENT_IP" "$CLIENT_MAC" "$DEV_MODE" "$DEV_ROUTING" "$CLIENT_HOST" || api_error "防火墙未就绪，未能切换设备模式"
    chmod 600 "$PEERS_FILE"
    if [ "$PREVIOUS_MODE|$PREVIOUS_ROUTING" != "$DEV_MODE|$DEV_ROUTING" ]; then
        if CONNECTIONS_RESET=$(/usr/sbin/netpilot-connections "$CLIENT_IP" 2>/dev/null); then
            CONNECTION_RESET_OK=true
        else
            CONNECTION_RESET_OK=false
            ACTION_MSG="$ACTION_MSG；旧连接未完全关闭，请重连此设备网络"
        fi
        case "$CONNECTIONS_RESET" in ''|*[!0-9]*) CONNECTIONS_RESET=0 ;; esac
        if [ "$CONNECTION_RESET_OK" = true ] && [ "$CONNECTIONS_RESET" -gt 0 ]; then
            ACTION_MSG="$ACTION_MSG（旧连接已重建）"
        fi
    fi
fi

get_core_metrics
BACKEND=$(cat "$CONF_DIR/backend" 2>/dev/null || echo unknown)
UDP_PROXY=false
case "$BACKEND" in tproxy|tc-tun) UDP_PROXY=true ;; esac
TUN_READY=false
if [ "$BACKEND" = tc-tun ]; then
    /usr/sbin/netpilot-tun check >/dev/null 2>&1 && TUN_READY=true
    [ "$TUN_READY" = true ] || FIREWALL_TUN_FAILED=true
fi
ADBLOCK_COUNT=$(cat "$CONF_DIR/adblock.count" 2>/dev/null || echo 0)
FIREWALL_READY=false
nft list table inet "$NFT_TABLE" >/dev/null 2>&1 && FIREWALL_READY=true
[ "${FIREWALL_TUN_FAILED:-false}" != true ] || FIREWALL_READY=false
curl -fsS --max-time 2 "$MIHOMO_API/version" >/dev/null 2>&1 || CORE_RUNNING=false

SAFE_HOST=$(json_escape "$CLIENT_HOST")
SAFE_IP=$(json_escape "$CLIENT_IP")
SAFE_MAC=$(json_escape "$CLIENT_MAC")
SAFE_MODE=$(json_escape "$DEV_MODE")
SAFE_ROUTING=$(json_escape "$DEV_ROUTING")
SAFE_MSG=$(json_escape "$ACTION_MSG")
CLASH_JSON=$(build_clash_list_json)
ADG_JSON=$(build_adg_list_json)
if [ -z "$NODES_JSON" ]; then
    NODES_JSON=$(/usr/sbin/netpilot-nodes list 2>/dev/null) || NODES_JSON='{"available":false,"selected":"","current":"","nodes":[],"message":"暂时无法读取节点"}'
fi

cat <<EOF
{
  "ok": true,
  "hostname": "${SAFE_HOST}",
  "ip": "${SAFE_IP}",
  "mac": "${SAFE_MAC}",
  "mode": "${SAFE_MODE}",
  "routing": "${SAFE_ROUTING}",
  "core_running": ${CORE_RUNNING},
  "firewall_ready": ${FIREWALL_READY},
  "backend": "${BACKEND}",
  "udp_proxy": ${UDP_PROXY},
  "tun_ready": ${TUN_READY},
  "proxy_failure_policy": "block",
  "adblock_rules": ${ADBLOCK_COUNT},
  "memory_mb": "${CORE_MEM_MB}",
  "clash_profiles": ${CLASH_JSON},
  "adg_sources": ${ADG_JSON},
  "node_selection": ${NODES_JSON},
  "connections_reset": ${CONNECTIONS_RESET},
  "connection_reset_ok": ${CONNECTION_RESET_OK},
  "version": "1.3.0",
  "ipv6_leak_guard": true,
  "sniffer": true,
  "message": "${SAFE_MSG}"
}
EOF
